# Scratch downloads from scripts/bullets/scrape.py. Normalized catalogs are committed.
data/bullets/raw/*
!data/bullets/raw/.gitkeep
__pycache__/
*.pyc
node_modules/

# Generated by `npm run normalize` and `npm run build`. The deploy workflow rebuilds them on every push to main.
data/normalized/*.json
data/normalized/REPORT.md
src/app/public/data/
dist/
